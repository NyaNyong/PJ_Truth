  m_Script: {fileID: 11500000, guid: 260458493d739464c86cb22263abe48b, type: 3}
  m_Name: Doc_003
  m_EditorClassIdentifier: 
  documentID: 1
  documentTitle: Example
  mainText: "\uC608\uC2DC \uC790\uB8CC - \uD615\uC740 \uC8FD\uC5C8\uC5B4. \uC774\uC81C
    \uB354\uB294 \uC5C6\uC5B4! \uD558\uC9C0\uB9CC, \uB0B4 \uB4F1\uC5D0, \uC774 \uAC00\uC2B4\uC5D0
    \uD558\uB098\uAC00 \uB418\uC5B4 \uACC4\uC18D \uC0B4\uC544\uAC00! \uAD6C\uBA4D\uC744
    \uD310\uB2E4\uBA74 \uD558\uB298\uC744 \uB6AB\uC744 \uB54C\uAE4C\uC9C0. \uC81C
    \uBB34\uB364\uC744 \uD30C\uB354\uB77C\uB3C4 \uADF8\uC870\uCC28 \uB6AB\uACE0\uC11C,
    \uBE60\uC838\uB098\uC62C \uC218 \uC788\uB2E4\uBA74 \uB098\uC758 \uC2B9\uB9AC\uB2E4!
    \uB098\uB97C \uB204\uAD6C\uB77C\uACE0 \uC0DD\uAC01\uD558\uB290\uB0D0, \uB098\uB294
    \uC2DC\uBAAC\uC774\uB2E4. \uCE74\uBBF8\uB098 \uD615\uC774 \uC544\uB2C8\uC57C!
    \uB098\uB294 \uB098\uB2E4! \uAD74\uCC29\uAFBC \uC2DC\uBAAC\uC774\uB2E4!"
  needsCensorship: 0
  targetCensorKeywords: []
  guidelineText: "\uCD5C\uACE0\uC758 \uBA85\uB300\uC0AC\uB2E4.\n\uC808\uB300\uB85C
    \uC0AD\uC81C\uD558\uC9C0 \uB9D0\uB3C4\uB85D."
